#!/bin/sh
# Default only an absent OpenCode Inbox preference; all other state is runtime-owned.
set -eu
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
cat >"$work/live.json"
if ! command -v uv >/dev/null 2>&1; then
  echo "Plannotator: uv missing; Inbox preference unchanged. Install uv and reapply." >&2
  if [ -s "$work/live.json" ]; then cat "$work/live.json"; else printf '%s\n' '{}'; fi
  exit 0
fi
cat >"$work/merge.py" <<'PYEOF'
import json
import sys


def load(raw):
    doc = json.loads(raw) if raw.strip() else {}
    if not isinstance(doc, dict):
        raise ValueError("config.json must be an object")
    if "inboxTool" in doc:
        pref = doc["inboxTool"]
        if not isinstance(pref, (bool, dict)):
            raise ValueError("inboxTool must be a boolean or host object")
        if isinstance(pref, dict) and any(not isinstance(v, bool) for v in pref.values()):
            raise ValueError("inboxTool host preferences must be booleans")
    return doc


raw = sys.stdin.read()
doc = load(raw)
if "--validate" not in sys.argv:
    pref = doc.setdefault("inboxTool", {})
    if isinstance(pref, dict):
        pref.setdefault("opencode", True)
    out = json.dumps(doc, indent=2, ensure_ascii=False)
    if raw.endswith("\n"):
        out += "\n"
    load(out)
    sys.stdout.write(out)
PYEOF
if uv run --no-project --quiet python "$work/merge.py" <"$work/live.json" >"$work/out.json" \
  && [ -s "$work/out.json" ] \
  && uv run --no-project --quiet python "$work/merge.py" --validate <"$work/out.json"; then
  cat "$work/out.json"
else
  echo "Plannotator: merge failed for ~/.plannotator/config.json; live file unchanged" >&2
  exit 1
fi
