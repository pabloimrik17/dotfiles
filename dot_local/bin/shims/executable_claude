#!/bin/sh
# claude-node-launch — PATH shim for `claude` (OpenSpec: nvm-aware-claude-launch).
#
# Installed at ~/.local/bin/shims/claude, AHEAD of the real ~/.local/bin/claude
# on PATH (see dot_zshrc.tmpl), so every launcher — the `wsc`/`wsh` aliases,
# gh-dash `-x claude`, AoE, or a typed `claude` — flows through it unchanged.
# It resolves the project's Node version from .nvmrc, activates it, then execs
# the real claude by absolute path. claude's child processes (the Bash tool,
# hooks, node/npm/bun) then inherit the project's Node via the prepended PATH.
#
# Why a shim and not a chpwd/worktrunk hook: launchers use `wt switch -x claude`
# (chdir+exec, not a shell `cd`), so no `chpwd` autoload fires; a post-start hook
# runs in a throwaway subprocess that never touches claude's env. The only point
# that runs *in the process that becomes claude* is the launch command itself.
#
# Performance: steady state NEVER sources nvm.sh (~0.8s); it only PATH-prepends
# the resolved version's bin/ dir (~0.4ms). nvm.sh is sourced ONLY in the cold/
# alias fallback (version not installed yet, or an alias like lts/*) — one-time.

set -u

REAL_CLAUDE="$HOME/.local/bin/claude"
NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
NODES="$NVM_DIR/versions/node"
AOE_PROFILE=${AOE_PROFILE-}
AOE_INSTANCE_ID=${AOE_INSTANCE_ID-}
GHD_AOE_STATE_HOME=${GHD_AOE_STATE_HOME-}
XDG_STATE_HOME=${XDG_STATE_HOME-}

# 1) Locate .nvmrc. First walk UP from $PWD (builtin path manipulation, no
#    `dirname` forks), covering the launch dir, the worktree root, and ancestors.
nvmrc=""
d=$PWD
while :; do
  [ -f "$d/.nvmrc" ] && { nvmrc="$d/.nvmrc"; break; }
  [ -z "$d" ] && break # just tested "/.nvmrc" (d="" => "$d/.nvmrc" == "/.nvmrc")
  d=${d%/*}
done

# Nothing above: the polyglot-monorepo case — the Node app lives in a subdir
# (e.g. apps/web/) so the single .nvmrc isn't at the root. Search DOWN, anchored
# at the *repo root*, never at $PWD. Anchoring at $PWD would, when launched from
# a dir that merely holds sibling project checkouts (e.g. ~/WebstormProjects),
# scan them all and activate an unrelated project's Node. The git-root probe also
# answers "are we even in a repo?" — outside one, we skip the search entirely.
# A single match is the supported case; zero or >1 fall through to passthrough.
if [ -z "$nvmrc" ]; then
  repo=$(git rev-parse --show-toplevel 2>/dev/null) || repo=""
  if [ -n "$repo" ]; then
    found=$(find "$repo" -maxdepth 4 \( -name node_modules -o -name .git \) -prune \
      -o -type f -name .nvmrc -print 2>/dev/null)
    n=$(printf '%s\n' "$found" | grep -c .)
    if [ "$n" -eq 1 ]; then
      nvmrc=$found
    elif [ "$n" -gt 1 ]; then
      # >1 is ambiguous for this case (the invariant is one .nvmrc per repo).
      # Don't guess — guessing once activated an unrelated project's Node.
      printf 'claude shim: %s .nvmrc found under %s; ambiguous, launching under ambient Node\n' \
        "$n" "$repo" >&2
    fi
  fi
fi

# 2) With a .nvmrc in hand, resolve and activate the version. No .nvmrc => skip
#    straight to delegation (near-zero-cost passthrough, no PATH change).
if [ -n "$nvmrc" ]; then
  ver=""
  IFS= read -r ver <"$nvmrc" || : # keep ver even when the file lacks a trailing \n
  ver=${ver#"${ver%%[![:space:]]*}"} # ltrim whitespace/CR
  ver=${ver%"${ver##*[![:space:]]}"} # rtrim whitespace/CR

  if [ -n "$ver" ]; then
    matched=""
    case "$ver" in
      v[0-9]* | [0-9]*)
        want=${ver#v}
        if [ -d "$NODES/v$want/bin" ]; then
          matched="v$want" # exact pin: 24.12.0 / v24.12.0
        elif [ -d "$NODES" ]; then
          # Major/minor prefix: 24 -> highest v24.* ; 24.12 -> highest v24.12.*
          matched=$(for cand in "$NODES/v$want".*/; do
            [ -d "$cand" ] && { cand=${cand%/}; printf '%s\n' "${cand##*/}"; }
          done | sort -V | tail -n1)
        fi
        ;;
    esac

    if [ -n "$matched" ] && [ -d "$NODES/$matched/bin" ]; then
      # Fast path: PATH-prepend only, never source nvm.sh.
      PATH="$NODES/$matched/bin:$PATH"
      export PATH
    elif [ -s "$NVM_DIR/nvm.sh" ]; then
      # Cold/alias fallback: a numeric pin not installed yet, or an alias form
      # (lts/*, node, stable, ...) that can't be resolved from the filesystem.
      # Source nvm + install/use (one-time); steady state returns to the fast path.
      # shellcheck disable=SC1090,SC1091
      . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 || :
      if command -v nvm >/dev/null 2>&1; then
        nvm use "$ver" >/dev/null 2>&1 || nvm install "$ver" >/dev/null 2>&1 || :
      fi
    else
      # A version is pinned but unsatisfiable: no installed match AND no nvm.sh
      # to install/resolve it (broken or nvm-less machine). Warn — don't fall
      # through silently — but still launch: refusing to start would brick every
      # claude invocation here, including worktrunk's `claude -p` commit-message
      # generation. claude itself is Node-independent; only its subprocesses are
      # affected, and the warning surfaces the misconfiguration.
      printf 'claude shim: cannot activate %s (no installed match, missing %s); launching under ambient Node\n' \
        "$ver" "$NVM_DIR/nvm.sh" >&2
    fi
  fi
fi

# 3) A managed gh-dash review may carry its persisted bootstrap arguments into
#    every AoE start. Only trust a marker whose profile, instance, and canonical
#    worktree all match this launch. On explicit resume, remove the exact
#    bootstrap prefix; a genuine first launch keeps it.
managed_review=false
review_ref=""
review_launch_state=""
case "$AOE_INSTANCE_ID" in
  [A-Za-z0-9]*)
    case "$AOE_INSTANCE_ID" in
      *[!A-Za-z0-9._-]*) ;;
      *)
        if [ -n "$AOE_PROFILE" ] && command -v jq >/dev/null 2>&1; then
          review_state_root=$GHD_AOE_STATE_HOME
          if [ -z "$review_state_root" ]; then
            if [ -n "$XDG_STATE_HOME" ]; then
              review_state_root="$XDG_STATE_HOME/ghd-aoe"
            else
              review_state_root="$HOME/.local/state/ghd-aoe"
            fi
          fi
          review_marker="$review_state_root/reviews/$AOE_INSTANCE_ID.json"
          if [ -r "$review_marker" ]; then
            marker_profile=$(jq -er '.profile | select(type == "string")' "$review_marker" 2>/dev/null) || marker_profile=""
            marker_instance=$(jq -er '.instanceId | select(type == "string")' "$review_marker" 2>/dev/null) || marker_instance=""
            marker_worktree=$(jq -er '.worktree | select(type == "string")' "$review_marker" 2>/dev/null) || marker_worktree=""
            review_ref=$(jq -er '.reviewRef | select(type == "string")' "$review_marker" 2>/dev/null) || review_ref=""
            review_launch_state=$(jq -er '.launchState | select(type == "string")' "$review_marker" 2>/dev/null) || review_launch_state=""
            current_worktree=$(pwd -P)
            if [ "$marker_profile" = "$AOE_PROFILE" ] &&
              [ "$marker_instance" = "$AOE_INSTANCE_ID" ] &&
              [ "$marker_worktree" = "$current_worktree" ] &&
              [ -n "$review_ref" ]; then
              managed_review=true
            fi
          fi
        fi
        ;;
    esac
    ;;
esac

if [ "$managed_review" = true ]; then
  has_resume=false
  has_fresh_session=false
  for argument in "$@"; do
    [ "$argument" = "--resume" ] && has_resume=true
    [ "$argument" = "--session-id" ] && has_fresh_session=true
  done

  if [ "$review_launch_state" = "started" ] && [ "$has_fresh_session" = true ]; then
    printf 'claude shim: cannot resume managed review %s; AoE supplied a fresh session\n' "$AOE_INSTANCE_ID" >&2
    exit 65
  fi

  if [ "$has_resume" = true ]; then
    if [ "${1-}" = "/review-team $review_ref" ]; then
      shift
    elif [ "${1-}" = "/review-team" ] && [ "${2-}" = "$review_ref" ]; then
      shift 2
    fi
  fi
fi

# 4) Delegate to the real claude by absolute path — never via PATH (that would
#    re-enter this shim). exec replaces the process, so the exit status passes
#    through unchanged.
if [ ! -x "$REAL_CLAUDE" ]; then
  printf 'claude shim: real claude not found at %s\n' "$REAL_CLAUDE" >&2
  exit 127
fi
exec "$REAL_CLAUDE" "$@"
