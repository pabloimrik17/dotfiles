# ~/.gitignore_global — managed by chezmoi
#
# The only global ignore file in effect. dot_gitconfig.tmpl sets
# core.excludesFile, which *replaces* the XDG default (~/.config/git/ignore)
# rather than stacking with it — patterns put there are silently dead. Add them
# here.

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# IDE — JetBrains
.idea/

# IDE — VS Code (ignore personal prefs, keep shareable project configs)
.vscode/settings.json
.vscode/extensions.json

# IDE — Vim / Neovim
*.swp
*.swo
*~

# IDE — Sublime Text
*.sublime-project
*.sublime-workspace

# Environment / secrets
.env*
!.env.example
!.env.template

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs
logs/
*.log

# Build output
dist/
build/
*.map

# Testing
coverage/
.nyc_output/

# Temp
tmp/
temp/

# Agent-local state — written into unrelated repos, so it belongs globally.
# Unanchored: Claude Code writes a .claude/ wherever it is started, not just at
# the repo root. Folded in from the now-removed ~/.config/git/ignore.
**/.claude/settings.local.json
# Root-anchored: manufactured by this repo's own worktrunk save-base hook, which
# only ever writes to the worktree root's .claude/.
.claude/.worktree-base
