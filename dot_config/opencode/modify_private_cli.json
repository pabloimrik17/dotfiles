#!/bin/sh
# OpenCode 2 CLI: manage theme name and scroll acceleration, preserving runtime preferences.
set -eu
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
cat >"$work/live.json"
if ! command -v uv >/dev/null 2>&1; then
  echo "OpenCode CLI: uv missing; CLI preferences unchanged. Install uv and reapply." >&2
  if [ -s "$work/live.json" ]; then cat "$work/live.json"; else printf '%s\n' '{}'; fi
  exit 0
fi
cat >"$work/merge.py" <<'PYEOF'
import json
import sys


def load(raw):
    doc = json.loads(raw) if raw.strip() else {}
    if not isinstance(doc, dict):
        raise ValueError("cli.json must be an object")
    for key in ("theme", "scroll"):
        if key in doc and not isinstance(doc[key], dict):
            raise ValueError(f"{key} must be an object")
    return doc


raw = sys.stdin.read()
doc = load(raw)
if "--validate" not in sys.argv:
    doc.setdefault("$schema", "https://opencode.ai/v2/cli.json")
    doc.setdefault("theme", {})["name"] = "catppuccin-macchiato"
    doc.setdefault("scroll", {})["acceleration"] = True
    out = json.dumps(doc, indent=2, ensure_ascii=False)
    if raw.endswith("\n"):
        out += "\n"
    load(out)
    sys.stdout.write(out)
PYEOF
if uv run --no-project --quiet python "$work/merge.py" <"$work/live.json" >"$work/out.json" \
  && [ -s "$work/out.json" ] \
  && uv run --no-project --quiet python "$work/merge.py" --validate <"$work/out.json"; then
  cat "$work/out.json"
else
  echo "OpenCode CLI: merge failed for ~/.config/opencode/cli.json; live file unchanged" >&2
  exit 1
fi
