{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "eslint": {
            "type": "local",
            "command": ["npx", "-y", "@eslint/mcp@0.3.12"],
            "enabled": true
        },
        "context7": {
            "type": "local",
            "command": ["npx", "-y", "@upstash/context7-mcp@4.1.1"],
            "enabled": true
        },
        "knip": {
            "type": "local",
            "command": ["npx", "-y", "@knip/mcp@0.0.36"],
            "enabled": true
        },
        "memory": {
            "type": "local",
            "command": ["npx", "-y", "@modelcontextprotocol/server-memory@2026.7.4"],
            "enabled": true
        },
        "playwright": {
            "type": "local",
            "command": ["npx", "-y", "@playwright/mcp@0.0.81"],
            "enabled": true
        },
        "chrome-devtools": {
            "type": "local",
            "command": ["npx", "-y", "chrome-devtools-mcp@1.9.0"],
            "enabled": true
        },
        "gh_grep": {
            "type": "remote",
            "url": "https://mcp.grep.app"
        }
    }
}
