# Paths whose children are merged key-by-key rather than replaced wholesale, so
# a plugin enabled outside chezmoi or a hook event we do not manage survives an
# apply. The document root is always merged key-by-key; every managed path that
# is not listed here is a leaf and replaces the live value entirely (so
# `permissions.allow` stays the curated list in git, and each `hooks.<Event>`
# array is imposed as a whole -- which is the unit AoE itself regenerates).
MERGE_CONTAINERS = {
    ("enabledPlugins",),
    ("extraKnownMarketplaces",),
    ("env",),
    ("hooks",),
    ("permissions",),
}

# Paths deleted from the live file. `hooks.PreCompact` held only the duplicate
# `bd prime` hook that the beads plugin already declares. The rest are the
# host-conditional entries, emitted as removals on hosts where the condition is
# false rather than merely omitted -- otherwise a key added on one host would
# live forever in another host's file.
REMOVE = [
    ("hooks", "PreCompact"),
{{- if not (and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64")) }}
    ("enabledPlugins", "superwhisper@superwhisper"),
    ("extraKnownMarketplaces", "superwhisper"),
{{- end }}
]


def overlay(live, managed, path):
    """Write managed values into `live`, recursing only through MERGE_CONTAINERS.

    Existing keys keep their position and genuinely new keys append, so the
    merge never reorders a file another writer has already sorted. That is what
    makes the loop terminate: whatever order the last writer chose survives, so
    the next `chezmoi diff` is clean.
    """
    for key, value in managed.items():
        child = path + (key,)
        if child in MERGE_CONTAINERS:
            node = live.get(key)
            if not isinstance(node, dict):
                node = OrderedDict()
                live[key] = node
            overlay(node, value, child)
        elif live.get(key) != value:
            live[key] = value


def drop(doc, path):
    node = doc
    for key in path[:-1]:
        if not isinstance(node, dict) or key not in node:
            return
        node = node[key]
    if isinstance(node, dict):
        node.pop(path[-1], None)


def main():
    raw = sys.stdin.read()
    if raw.strip():
        live = json.loads(raw, object_pairs_hook=OrderedDict)
        if not isinstance(live, dict):
            raise ValueError("settings.json is not a JSON object")
    else:
        live = OrderedDict()  # fresh machine: the managed keys are the baseline

    overlay(live, MANAGED, ())
    for path in REMOVE:
        drop(live, path)

    # Match what the other two writers emit: two-space indent, and whichever
    # trailing-newline convention the live file already used.
    out = json.dumps(live, indent=2)
    if raw.endswith("\n"):
        out += "\n"

    json.loads(out)  # never emit anything that will not re-parse
    sys.stdout.write(out)


if "--validate" in sys.argv:
    json.load(sys.stdin)  # gate used by the shell on the merged output
else:
    main()
PYEOF

# Buffer the merge, then gate it: the result reaches the target only if the
# merge exited zero, wrote something, and that something re-parses as JSON.
# stderr is deliberately NOT redirected -- chezmoi surfaces it, and it is the
# only indication that an apply silently changed nothing.
if uv run --no-project --quiet python "$prog" <"$infile" >"$outfile" \
  && [ -s "$outfile" ] \
  && uv run --no-project --quiet python "$prog" --validate <"$outfile"; then
  cat "$outfile"
else
  cat "$infile"
fi
