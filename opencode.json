{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "eslint": {
                "type": "local",
                "command": ["npx", "-y", "@eslint/mcp@0.3.15"],
                "disabled": false
            },
            "context7": {
                "type": "local",
                "command": ["npx", "-y", "@upstash/context7-mcp@4.4.4"],
                "disabled": false
            },
            "knip": {
                "type": "local",
                "command": ["npx", "-y", "@knip/mcp@0.0.37"],
                "disabled": false
            },
            "memory": {
                "type": "local",
                "command": ["npx", "-y", "@modelcontextprotocol/server-memory@2026.8.31"],
                "disabled": false
            },
            "playwright": {
                "type": "local",
                "command": ["npx", "-y", "@playwright/mcp@0.0.81"],
                "disabled": false
            },
            "chrome-devtools": {
                "type": "local",
                "command": ["npx", "-y", "chrome-devtools-mcp@1.9.0"],
                "disabled": false
            },
            "gh_grep": {
                "type": "remote",
                "url": "https://mcp.grep.app"
            }
        }
    }
}
