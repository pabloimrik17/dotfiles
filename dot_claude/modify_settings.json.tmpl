#!/bin/sh
# chezmoi modify_ script for ~/.claude/settings.json.
#
# THREE writers own this file: chezmoi, Claude Code (`/config` plus its own
# settings writes) and Agent of Empires (its hook installer). AoE merges
# correctly and Claude Code edits surgically; only chezmoi ever replaced the
# whole file, so only chezmoi lost the other two's work. This script overlays
# ONLY the keys in MANAGED and passes everything else through, so `chezmoi
# apply` converges instead of ping-ponging. Pinning a source key order was
# already tried (85992e0, written to match AoE's serialization and cmp-verified
# byte-identical) and still drifted -- there are three writers, not two.
# See the claude-settings-merge capability, design D1-D4.
#
# Engine: `uv run --no-project python`. `uv` is a declared BREW_PACKAGES entry,
# so this adds no dependency, and `json` is stdlib -- no `--with`, and no
# network on a cold cache. `--no-project` stops uv attaching to whatever project
# `chezmoi apply` happened to be invoked from. Not jq: jq is absent from
# BREW_PACKAGES, and the binary on PATH here is Apple's /usr/bin/jq, which
# exists only on macOS 15+ and not at all on the Linux the README supports.
#
# FAIL CLOSED (D2). chezmoi writes a modify_ script's stdout to the target
# VERBATIM, with two escape hatches (verified against chezmoi v2.72.0): a script
# that exits NON-ZERO leaves the target untouched and reports the status, but a
# script that exits ZERO having written nothing REMOVES the target outright --
# it does not truncate it. The second case is the dangerous one, so every
# failure path here re-emits the captured stdin unchanged: `uv` absent, the
# merge exiting non-zero, or output that does not re-parse as JSON. A silent
# no-op apply is the deliberate trade. Failures before stdin is captured (a
# `mktemp` that cannot allocate) are deliberately left to `set -e`: exiting
# non-zero preserves the live file AND surfaces the error, which a silent
# pass-through would hide. Exactly one `--quiet` -- `-qq` would suppress the
# stderr diagnostic that is the only signal.
set -eu

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
infile="$work/live.json"
outfile="$work/merged.json"

# Capture stdin verbatim (byte-exact: no $(cat) trailing-newline stripping).
cat >"$infile"

# uv absent (cold start, before the brew bootstrap has run): pass the live file
# through untouched. The next apply self-heals once uv is installed.
if ! command -v uv >/dev/null 2>&1; then
  cat "$infile"
  exit 0
fi

prog="$work/merge.py"
cat >"$prog" <<'PYEOF'
