# ------------------------------------------------------------------
# Group 8.5: Claude Code MCP servers
# ------------------------------------------------------------------
MCP_STDIO_SERVERS=(
    "eslint:npx:-y:@eslint/mcp@0.3.0"
    "context7:npx:-y:@upstash/context7-mcp@2.1.2"
    "knip:npx:-y:@knip/mcp@0.0.19"
    "memory:npx:-y:@modelcontextprotocol/server-memory@2026.1.26"
    "playwright:npx:-y:@playwright/mcp@0.0.68"
    "chrome-devtools:npx:-y:chrome-devtools-mcp@0.18.1"
    "expect:npx:-y:expect-cli@0.1.3:mcp"
    # PATH binary from the global npm install — no npx, no pin (version owned
    # by the global install / update-extra), so presence-checked only
    "fallow:fallow-mcp"
)

MCP_HTTP_SERVERS=(
    "gh_grep:https://mcp.grep.app"
    "atlassian:https://mcp.atlassian.com/v1/mcp"
    "figma:https://mcp.figma.com/mcp"
    "linear:https://mcp.linear.app/mcp"
    "notion:https://mcp.notion.com/mcp"
    "storybook:http://localhost:6006/mcp"
)

if ! command -v claude &>/dev/null; then
    warn "Claude Code is not installed — skipping MCP server registration"
elif ! command -v jq &>/dev/null; then
    warn "jq is required for MCP server detection — skipping MCP server registration"
else
    # Pre-scan: query ~/.claude.json with jq, scoped to .mcpServers
    # (claude mcp list has no --json flag; grep would false-match on per-project mcpServers and other fields)
    mcp_registered() {
        local name="$1"
        [ -f "$HOME/.claude.json" ] && jq -e --arg n "$name" '.mcpServers[$n] // empty' "$HOME/.claude.json" >/dev/null 2>&1
    }

    mcp_config_matches() {
        local name="$1"
        local match_string="$2"
        [ -f "$HOME/.claude.json" ] && jq -e --arg n "$name" --arg s "$match_string" '.mcpServers[$n] | tostring | contains($s)' "$HOME/.claude.json" >/dev/null 2>&1
    }

    # Count new and outdated servers
    TOTAL_MCP=$(( ${#MCP_STDIO_SERVERS[@]} + ${#MCP_HTTP_SERVERS[@]} ))
    PENDING_MCP=0
    OUTDATED_MCP=0
    for entry in "${MCP_STDIO_SERVERS[@]}"; do
        name="${entry%%:*}"
        rest="${entry#*:}"
        IFS=':' read -ra parts <<< "$rest"
        # Find the package@version part (contains @<digit>)
        pkg_version=""
        for part in "${parts[@]}"; do
            if [[ "$part" == *@[0-9]* ]]; then pkg_version="$part"; break; fi
        done
        if ! mcp_registered "$name"; then
            PENDING_MCP=$((PENDING_MCP + 1))
        elif [ -n "$pkg_version" ] && ! mcp_config_matches "$name" "$pkg_version"; then
            OUTDATED_MCP=$((OUTDATED_MCP + 1))
        fi
    done
    for entry in "${MCP_HTTP_SERVERS[@]}"; do
        name="${entry%%:*}"
        url="${entry#*:}"
        if ! mcp_registered "$name"; then
            PENDING_MCP=$((PENDING_MCP + 1))
        elif ! mcp_config_matches "$name" "$url"; then
            OUTDATED_MCP=$((OUTDATED_MCP + 1))
        fi
    done

    CHANGES_MCP=$((PENDING_MCP + OUTDATED_MCP))
    if [ "$CHANGES_MCP" -eq 0 ]; then
        info "MCP servers: $TOTAL_MCP/$TOTAL_MCP registered (all up to date)"
    else
        if confirm "Register MCP servers ($CHANGES_MCP changes: $PENDING_MCP new, $OUTDATED_MCP outdated)?"; then
            info "  Registering stdio MCP servers..."
            for entry in "${MCP_STDIO_SERVERS[@]}"; do
                name="${entry%%:*}"
                rest="${entry#*:}"
                IFS=':' read -ra parts <<< "$rest"
                pkg_version=""
                for part in "${parts[@]}"; do
                    if [[ "$part" == *@[0-9]* ]]; then pkg_version="$part"; break; fi
                done
                if ! mcp_registered "$name"; then
                    run_claude_step "mcp $name" claude mcp add --scope user "$name" -- "${parts[@]}"
                elif [ -n "$pkg_version" ] && ! mcp_config_matches "$name" "$pkg_version"; then
                    info "  $name — version changed, updating..."
                    run_claude_step "mcp remove $name" claude mcp remove "$name" -s user
                    # Verify removal before re-adding (remove may fail silently due to Bun PTY issues)
                    if mcp_registered "$name"; then
                        error "  $name — remove failed, skipping update"
                    else
                        run_claude_step "mcp $name" claude mcp add --scope user "$name" -- "${parts[@]}"
                    fi
                else
                    info "  $name — already registered, skipping"
                fi
            done

            info "  Registering http MCP servers..."
            for entry in "${MCP_HTTP_SERVERS[@]}"; do
                name="${entry%%:*}"
                url="${entry#*:}"
                if ! mcp_registered "$name"; then
                    run_claude_step "mcp $name" claude mcp add --scope user --transport http "$name" "$url"
                elif ! mcp_config_matches "$name" "$url"; then
                    info "  $name — URL changed, updating..."
                    run_claude_step "mcp remove $name" claude mcp remove "$name" -s user
                    if mcp_registered "$name"; then
                        error "  $name — remove failed, skipping update"
                    else
                        run_claude_step "mcp $name" claude mcp add --scope user --transport http "$name" "$url"
                    fi
                else
                    info "  $name — already registered, skipping"
                fi
            done
        else
            info "Skipping MCP server registration."
        fi
    fi
fi

# ------------------------------------------------------------------
# Group 8.75: Codex plugins
# ------------------------------------------------------------------
# Codex owns its plugin state under ~/.codex (bundles land in a cache path it
# may prune), so chezmoi manages no file there. Parity comes from driving the
# official CLI idempotently, the same way Group 8 drives `claude plugin`.
CODEX_PLUGINS=(
    "superpowers@openai-curated"
)

if ! command -v codex &>/dev/null; then
    warn "Codex is not installed — skipping plugin setup"
elif ! command -v jq &>/dev/null; then
    warn "jq is required for Codex plugin detection — skipping Codex plugins"
elif ! CODEX_PLUGIN_JSON="$(codex plugin list --json 2>/dev/null)"; then
    # Do not let a failed query look like an empty inventory: that would mark
    # every plugin pending and prompt to reinstall what is already there.
    warn "Could not query Codex plugins — skipping Codex plugin setup"
elif ! jq -e '(.installed | type) == "array"' >/dev/null 2>&1 <<<"$CODEX_PLUGIN_JSON"; then
    warn "Codex returned unreadable plugin data — skipping Codex plugin setup"
else
    # Scope the match to `.installed[]`. Without `--available` that is the only
    # populated array, but scoping keeps the check correct if the payload ever
    # carries `available[]` too.
    codex_plugin_installed() {
        local plugin_id="$1"
        jq -e --arg id "$plugin_id" \
            '.installed[]? | select(.pluginId == $id and .installed == true)' \
            >/dev/null 2>&1 <<<"$CODEX_PLUGIN_JSON"
    }

    codex_plugin_enabled() {
        local plugin_id="$1"
        jq -e --arg id "$plugin_id" \
            '.installed[]? | select(.pluginId == $id and .enabled == true)' \
            >/dev/null 2>&1 <<<"$CODEX_PLUGIN_JSON"
    }

    PENDING_CODEX=0
    TOTAL_CODEX=${#CODEX_PLUGINS[@]}
    for plugin in "${CODEX_PLUGINS[@]}"; do
        if ! codex_plugin_installed "$plugin"; then
            PENDING_CODEX=$((PENDING_CODEX + 1))
        elif ! codex_plugin_enabled "$plugin"; then
            # Deliberate disables are the user's call — surface it, do not reinstall.
            warn "$plugin is installed but disabled — enable it in Codex to use its skills"
        fi
    done

    if [ "$PENDING_CODEX" -eq 0 ]; then
        info "Codex plugins: $TOTAL_CODEX/$TOTAL_CODEX installed"
    elif confirm "Install Codex plugins ($PENDING_CODEX/$TOTAL_CODEX pending)?"; then
        for plugin in "${CODEX_PLUGINS[@]}"; do
            if codex_plugin_installed "$plugin"; then
                info "  $plugin — already installed, skipping"
            else
                info "  Installing $plugin..."
                if ! codex plugin add "$plugin"; then
                    # Not an installation error: a managed workspace can withhold
                    # a plugin from the user's role, and `error` would exit 1.
                    warn "Could not install Codex plugin $plugin — if your workspace withholds it, ask an administrator to make it available to your role"
                fi
            fi
        done
    else
        info "Skipping Codex plugins."
    fi
fi

# ------------------------------------------------------------------
# Group 9: Agent skills (skills.sh)
# ------------------------------------------------------------------
if confirm "Install global agent skills via skills.sh?"; then
    if command -v npx &>/dev/null; then
        # Query already-installed global skills
        INSTALLED_SKILLS=""
        if SKILLS_JSON="$(npx -y skills list -g --json 2>/dev/null)"; then
            INSTALLED_SKILLS="$SKILLS_JSON"
        else
            warn "Could not query installed global skills; proceeding without skip checks"
        fi

        # `skills list --json` reports agents by display name, while
        # `skills add --agent` takes slugs. Map slug -> display name so the
        # skip check can compare the two.
        skill_agent_display() {
            case "$1" in
                claude-code) echo "Claude Code" ;;
                opencode) echo "OpenCode" ;;
                junie) echo "Junie" ;;
                codex) echo "Codex" ;;
                cursor) echo "Cursor" ;;
                gemini-cli) echo "Gemini CLI" ;;
                github-copilot) echo "GitHub Copilot" ;;
                *) echo "$1" ;;
            esac
        }

        skill_installed() {
            local name="$1"
            local agents="$2"
            [ -n "$INSTALLED_SKILLS" ] || return 1

            if ! command -v jq &>/dev/null; then
                # Without jq the agent list cannot be inspected. A call that
                # requests specific agents must not be skipped on a name match
                # alone, or the missing coverage would never be reconciled.
                if [ -n "$agents" ]; then
                    return 1
                fi
                # No agents requested: a name-only match is the whole check.
                echo "$INSTALLED_SKILLS" | grep -q "\"name\": \"$name\""
                return
            fi

            echo "$INSTALLED_SKILLS" | jq -e --arg n "$name" \
                'any(.[]; .name == $n)' >/dev/null 2>&1 || return 1

            # A cached skill with missing agent targets must not be skipped, or
            # the requested coverage would never be reconciled on a rerun.
            local agent display
            # Intentional word splitting: $agents is a space-separated list.
            for agent in $agents; do
                display="$(skill_agent_display "$agent")"
                echo "$INSTALLED_SKILLS" | jq -e --arg n "$name" --arg d "$display" \
                    'any(.[]; .name == $n and ((.agents // []) | index($d)))' >/dev/null 2>&1 || return 1
            done
        }

        install_skill() {
            local repo="$1"
            local name="$2"
            local agents="$3"
            if skill_installed "$name" "$agents"; then
                info "  $name — already installed, skipping"
            elif [ -n "$agents" ]; then
                # Intentional word splitting: $agents is a space-separated
                # list for the variadic --agent flag.
                run_claude_step "skill $name" npx -y skills add "$repo" --skill "$name" -g -y --agent $agents
            else
                run_claude_step "skill $name" npx -y skills add "$repo" --skill "$name" -g -y
            fi
        }

        install_skill "vercel-labs/skills" "find-skills"
        install_skill "vercel-labs/agent-skills" "vercel-react-best-practices"
        install_skill "vercel-labs/agent-skills" "web-design-guidelines"
        install_skill "vercel-labs/agent-skills" "vercel-composition-patterns"
        install_skill "anthropics/skills" "frontend-design"
        install_skill "anthropics/skills" "skill-creator"
        install_skill "anthropics/skills" "pdf"
        install_skill "anthropics/skills" "pptx"
        install_skill "anthropics/skills" "docx"
        install_skill "anthropics/skills" "xlsx"
        install_skill "coderabbitai/skills" "code-review"
        install_skill "coderabbitai/skills" "autofix"
        install_skill "slidevjs/slidev" "slidev"
        install_skill "gluestack/agent-skills" "gluestack-ui-v5" "claude-code opencode junie codex"
        install_skill "mattpocock/skills" "ask-matt" "opencode junie"
        install_skill "mattpocock/skills" "diagnosing-bugs" "opencode junie"
        install_skill "mattpocock/skills" "grill-with-docs" "opencode junie"
