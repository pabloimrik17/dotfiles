#!/bin/bash
# run_onchange_install-packages.sh — chezmoi re-runs this when its content changes
# Installs tool dependencies with interactive confirmation per group.

# Note: set -e intentionally omitted — script continues on individual package failures
set -o pipefail

# Redirect all output to the controlling terminal so prompts and progress stay
# visible however chezmoi itself was invoked (piped, redirected, or nested inside
# another tool).
#
# chezmoi does NOT capture a run_ script's output — it wires run_ script stdio
# straight to its own. Capture applies to modify_ scripts, whose stdout *is* the
# target file. So the reason for this redirect is chezmoi's own stdout not being
# guaranteed to be a terminal, not chezmoi swallowing anything. confirm() reads
# from /dev/tty for the same reason, and degrades to "no" when there is none.
exec > /dev/tty 2>&1

ERRORS=0

info() {
    echo "[dotfiles] $*"
}

warn() {
    echo "[dotfiles] WARNING: $*" >&2
}

error() {
    echo "[dotfiles] ERROR: $*" >&2
    ERRORS=$((ERRORS + 1))
}

run_claude_step() {
    local label="$1"
    shift
    # Claude Code runs on Bun, which crashes with EINVAL kqueue errors
    # when tty.WriteStream gets a non-TTY fd (oven-sh/bun#24158).
    # Wrap with `script` to provide a pseudo-TTY on macOS.
    local output_file
    output_file="$(mktemp)"
    if [[ "$OSTYPE" == darwin* ]]; then
        script -q "$output_file" "$@" >/dev/null 2>&1
    else
        "$@" >"$output_file" 2>&1
    fi
    local rc=$?
    if [ "$rc" -ne 0 ]; then
        error "Claude step failed: $label ($*)"
        # Show output on failure, filtering Bun runtime noise
        if [ -s "$output_file" ] && ! grep -q 'process\.std.*\.fd\|process\.std.*\.isTTY\|EINVAL.*kqueue' "$output_file"; then
            sed 's/^/        /' "$output_file" >&2
        fi
    fi
    rm -f "$output_file"
    return 0  # always continue script
}

confirm() {
    local prompt="$1"
    local reply
    printf "[dotfiles] %s [Y/n] " "$prompt"
    if ! read -r reply </dev/tty 2>/dev/null; then
        warn "No TTY available for '$prompt' — defaulting to no"
        return 1
    fi
    case "$reply" in
        [nN]*) return 1 ;;
        *) return 0 ;;
    esac
}

{{ if eq .chezmoi.os "darwin" -}}
# ====================================================================
# macOS — install via Homebrew
# ====================================================================

if ! command -v brew &>/dev/null; then
    error "Homebrew is not installed. Please install it first: https://brew.sh"
    exit 1
fi

# ------------------------------------------------------------------
# Group 1: Brew packages
# ------------------------------------------------------------------
BREW_TAPS=(tarkah/tickrs achannarasappa/tap)
BREW_PACKAGES=(git git-delta starship eza bat zoxide atuin fzf ripgrep lazygit worktrunk terminal-notifier fd direnv beads gh tmux uv mas wget television tickrs ticker age mole aoe glow mdfried)

# Resolve the binary name for a given package (bash 3 compatible)
pkg_bin() {
    case "$1" in
        git-delta) echo "delta" ;;
        ripgrep)   echo "rg" ;;
        worktrunk) echo "wt" ;;
        beads)     echo "bd" ;;
        television) echo "tv" ;;
        *)         echo "$1" ;;
    esac
}

# Register third-party Homebrew taps before the pre-scan.
# `brew tap` is idempotent: returns 0 without re-fetching if already tapped.
for tap in "${BREW_TAPS[@]}"; do
    if ! brew tap "$tap"; then
        error "Failed to tap $tap"
    fi
done

# Pre-scan: check which brew packages are already installed
BREW_PENDING=0
for pkg in "${BREW_PACKAGES[@]}"; do
    if [ "$pkg" = "git" ]; then
        brew list git &>/dev/null || BREW_PENDING=$((BREW_PENDING + 1))
    else
        bin="$(pkg_bin "$pkg")"
        command -v "$bin" &>/dev/null || BREW_PENDING=$((BREW_PENDING + 1))
    fi
done

if [ "$BREW_PENDING" -eq 0 ]; then
    info "Brew packages: ${#BREW_PACKAGES[@]}/${#BREW_PACKAGES[@]} installed"
elif confirm "Install brew packages ($BREW_PENDING/${#BREW_PACKAGES[@]} pending)?"; then
    info "Installing brew packages..."
    for pkg in "${BREW_PACKAGES[@]}"; do
        if [ "$pkg" = "git" ]; then
            # Always install brew git — system git at /usr/bin/git is outdated
            if brew list git &>/dev/null; then
                info "  git — already installed (brew), skipping"
            else
                info "  Installing git (brew version)..."
                if ! brew install git; then
                    error "Failed to install git"
                fi
            fi
        else
            bin="$(pkg_bin "$pkg")"
            if command -v "$bin" &>/dev/null; then
                info "  $pkg — already installed, skipping"
            else
                info "  Installing $pkg..."
                if ! brew install "$pkg"; then
                    error "Failed to install $pkg"
                fi
            fi
        fi
    done
else
    info "Skipping brew packages."
fi

# ------------------------------------------------------------------
# Group 1.5: opencode + CodeRabbit + Codex (official installers, self-updating)
# ------------------------------------------------------------------
# Installed via official scripts instead of brew/cask so their built-in
# auto-update works — a package-manager install disables it. Ordered right
# after brew packages so opencode is on PATH before the OpenCode plugins
# group (Group 7) probes for it.

# ~/.opencode/bin and ~/.local/bin hold the official-install binaries. Put them
# on PATH for this run regardless of the prompt below: later groups probe
# `command -v opencode`, and the CodeRabbit and Codex installers place their
# binaries in ~/.local/bin. PATH edits are non-destructive.
OPENCODE_BIN_DIR="$HOME/.opencode/bin"
CODEX_BIN="$HOME/.local/bin/codex"
export PATH="$OPENCODE_BIN_DIR:$HOME/.local/bin:$PATH"
hash -r

# Pre-scan: a tool is "pending" if it still needs installing or migrating off
# a package manager. Skip the prompt when all use their official installs.
OC_PENDING=0
[ -x "$OPENCODE_BIN_DIR/opencode" ] || OC_PENDING=1
brew list opencode &>/dev/null && OC_PENDING=1
CR_PENDING=0
[ -x "$HOME/.local/bin/coderabbit" ] || CR_PENDING=1
brew list --cask coderabbit &>/dev/null && CR_PENDING=1
CODEX_BREW_INSTALLED=0
brew list --cask codex &>/dev/null && CODEX_BREW_INSTALLED=1
CODEX_NPM_INSTALLED=0
if command -v npm &>/dev/null && npm list --global --depth=0 @openai/codex &>/dev/null; then
    CODEX_NPM_INSTALLED=1
fi
CODEX_PENDING=0
[ -x "$CODEX_BIN" ] || CODEX_PENDING=1
[ "$CODEX_BREW_INSTALLED" -eq 1 ] && CODEX_PENDING=1
[ "$CODEX_NPM_INSTALLED" -eq 1 ] && CODEX_PENDING=1

if [ "$((OC_PENDING + CR_PENDING + CODEX_PENDING))" -eq 0 ]; then
    info "opencode + CodeRabbit + Codex: installed via official scripts"
elif confirm "Install/migrate opencode + CodeRabbit + Codex to official installers ($((OC_PENDING + CR_PENDING + CODEX_PENDING)) pending)?"; then
    # --- opencode → ~/.opencode/bin ---
    # Install via the official script first (with --no-modify-path so it does
    # not edit the chezmoi-managed ~/.zshrc), then migrate off brew ONLY after
    # the new binary is verified present — a failed install must not strand the
    # user with neither copy.
    if [ -x "$OPENCODE_BIN_DIR/opencode" ]; then
        info "  opencode — already installed via official script, skipping"
    else
        info "  Installing opencode via official script..."
        if ! curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path; then
            error "Failed to install opencode"
        fi
        hash -r
    fi
    if [ -x "$OPENCODE_BIN_DIR/opencode" ] && brew list opencode &>/dev/null; then
        info "  Migrating opencode off Homebrew..."
        brew uninstall opencode || error "Failed to uninstall brew opencode"
        brew untap anomalyco/tap &>/dev/null || true  # tap no longer needed
        hash -r
    fi

    # --- CodeRabbit → ~/.local/bin (non-interactive) ---
    # Same install-then-migrate ordering. No `coderabbit update` on re-runs:
    # the CLI self-updates on its own, so forcing it on every apply only adds
    # surprise version drift. Migrate off the cask without --zap to keep
    # ~/.coderabbit auth/config.
    if [ -x "$HOME/.local/bin/coderabbit" ]; then
        info "  coderabbit — already installed via official script, skipping"
    else
        info "  Installing CodeRabbit via official script..."
        # CI=1 on the installer (sh) skips its interactive login prompt; auth is
        # deferred to first interactive use.
        if ! curl -fsSL https://cli.coderabbit.ai/install.sh | CI=1 sh; then
            error "Failed to install CodeRabbit"
        fi
        hash -r
    fi
    if [ -x "$HOME/.local/bin/coderabbit" ] && brew list --cask coderabbit &>/dev/null; then
        info "  Migrating CodeRabbit off the Homebrew cask..."
        brew uninstall --cask coderabbit || error "Failed to uninstall coderabbit cask"
        hash -r
    fi

    # --- Codex → ~/.local/bin (non-interactive) ---
    # A package-manager migration always reruns the standalone installer: an
    # npm global prefix may place its shim at the same path. Give the installer
    # only system paths plus its destination so it cannot detect the legacy
    # command and add an unmanaged PATH block to a shell profile.
    CODEX_STANDALONE_VERIFIED=0
    if [ "$CODEX_BREW_INSTALLED" -eq 1 ] || [ "$CODEX_NPM_INSTALLED" -eq 1 ] || [ ! -x "$CODEX_BIN" ]; then
        # Preserve any command already at the destination until the installer
        # succeeds. This may be an npm shim when npm's global prefix is
        # ~/.local; a late installer failure must restore that working legacy
        # command rather than leave an unverified standalone target behind.
        CODEX_PREINSTALL_BIN_BACKUP="$CODEX_BIN.preinstall.$$"
        CODEX_INSTALL_READY=1
        CODEX_PREINSTALL_HAD_BIN=0
        CODEX_PREINSTALL_RESTORE_NEEDED=0
        if [ -e "$CODEX_BIN" ] || [ -L "$CODEX_BIN" ]; then
            CODEX_PREINSTALL_HAD_BIN=1
        fi
        restore_codex_preinstall_bin() {
            [ "$CODEX_PREINSTALL_RESTORE_NEEDED" -eq 1 ] || return 0
            if [ "$CODEX_PREINSTALL_HAD_BIN" -eq 1 ]; then
                # A missing backup means a previous invocation already restored
                # it. Do not remove that restored command on a repeated EXIT.
                if [ -e "$CODEX_PREINSTALL_BIN_BACKUP" ] || [ -L "$CODEX_PREINSTALL_BIN_BACKUP" ]; then
                    rm -f "$CODEX_BIN" || return 1
                    mv "$CODEX_PREINSTALL_BIN_BACKUP" "$CODEX_BIN" || return 1
                fi
            else
                rm -f "$CODEX_BIN" || return 1
            fi
            CODEX_PREINSTALL_RESTORE_NEEDED=0
            CODEX_PREINSTALL_BIN_BACKUP=""
        }
        # Arm rollback before the first move so a signal cannot strand the
        # existing command under its temporary backup name.
        CODEX_PREINSTALL_RESTORE_NEEDED=1
        trap 'restore_codex_preinstall_bin' EXIT
        if [ "$CODEX_PREINSTALL_HAD_BIN" -eq 1 ] && ! mv "$CODEX_BIN" "$CODEX_PREINSTALL_BIN_BACKUP"; then
            error "Failed to protect existing Codex command before standalone installation"
            CODEX_INSTALL_READY=0
            CODEX_PREINSTALL_RESTORE_NEEDED=0
            trap - EXIT
        fi
        if [ "$CODEX_INSTALL_READY" -eq 1 ]; then
            info "  Installing Codex via official script..."
            CODEX_INSTALLER_PATH="$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            if curl -fsSL https://chatgpt.com/codex/install.sh | PATH="$CODEX_INSTALLER_PATH" CODEX_INSTALL_DIR="$HOME/.local/bin" CODEX_NON_INTERACTIVE=1 sh; then
                if [ ! -x "$CODEX_BIN" ] || ! "$CODEX_BIN" --version &>/dev/null; then
                    error "Codex installer completed but $CODEX_BIN failed verification"
                else
                    CODEX_STANDALONE_VERIFIED=1
                fi
            else
                error "Failed to install Codex"
            fi
            if [ "$CODEX_STANDALONE_VERIFIED" -eq 1 ]; then
                # Commit before deleting the backup. If a signal arrives in this
                # window, the EXIT handler becomes a no-op and cannot remove the
                # newly verified standalone command.
                CODEX_PREINSTALL_RESTORE_NEEDED=0
                trap - EXIT
                rm -f "$CODEX_PREINSTALL_BIN_BACKUP" || error "Failed to remove pre-install Codex command backup"
                CODEX_PREINSTALL_BIN_BACKUP=""
            elif restore_codex_preinstall_bin; then
                trap - EXIT
            else
                error "Failed to restore pre-install Codex command after standalone installation failure"
            fi
        fi
        hash -r
    else
        info "  codex — already installed via official script, skipping"
        CODEX_STANDALONE_VERIFIED=1
    fi
    if [ "$CODEX_STANDALONE_VERIFIED" -eq 1 ] && [ "$CODEX_BREW_INSTALLED" -eq 1 ]; then
        info "  Migrating Codex off the Homebrew cask..."
        brew uninstall --cask codex || error "Failed to uninstall codex cask"
        hash -r
    fi
    if [ "$CODEX_STANDALONE_VERIFIED" -eq 1 ] && [ "$CODEX_NPM_INSTALLED" -eq 1 ]; then
        info "  Migrating Codex off global npm..."
        # npm removes its configured bin path without checking ownership. Move
        # the verified standalone command aside so a ~/.local npm prefix cannot
        # delete it, then restore it after npm updates its package state.
        CODEX_BIN_BACKUP="$CODEX_BIN.codex-standalone.$$"
        if mv "$CODEX_BIN" "$CODEX_BIN_BACKUP"; then
            restore_codex_bin() {
                if [ -e "$CODEX_BIN_BACKUP" ] || [ -L "$CODEX_BIN_BACKUP" ]; then
                    rm -f "$CODEX_BIN"
                    mv "$CODEX_BIN_BACKUP" "$CODEX_BIN" || return 1
                fi
                CODEX_BIN_BACKUP=""
            }
            trap 'restore_codex_bin' EXIT
            npm uninstall --global @openai/codex || error "Failed to uninstall global @openai/codex"
            if restore_codex_bin; then
                trap - EXIT
            else
                error "Failed to restore standalone Codex command after npm migration"
            fi
        else
            error "Failed to protect standalone Codex command during npm migration"
        fi
        if [ ! -x "$CODEX_BIN" ] || ! "$CODEX_BIN" --version &>/dev/null; then
            error "Standalone Codex command failed verification after npm migration"
        fi
        hash -r
    fi
else
    info "Skipping opencode + CodeRabbit + Codex official-installer setup."
fi

# ------------------------------------------------------------------
# Television: download community cable channels
# ------------------------------------------------------------------
if command -v tv &>/dev/null; then
    info "Updating television cable channels..."
    tv update-channels 2>/dev/null || warn "Failed to update television cable channels (network issue?)"
fi

# ------------------------------------------------------------------
# Atuin: import existing shell history
# ------------------------------------------------------------------
if command -v atuin &>/dev/null; then
    ATUIN_COUNT="$(atuin history list 2>/dev/null | wc -l | tr -d ' ')"
    if [ "$ATUIN_COUNT" -eq 0 ]; then
        info "  Importing shell history into atuin..."
        atuin import auto 2>/dev/null || true
    fi
fi

# ------------------------------------------------------------------
# Bat theme: Catppuccin Mocha
# ------------------------------------------------------------------
if command -v bat &>/dev/null; then
    BAT_THEMES_DIR="$(bat --config-dir)/themes"
    if [ -f "$BAT_THEMES_DIR/Catppuccin Mocha.tmTheme" ]; then
        info "  bat Catppuccin Mocha theme — already installed, skipping"
    else
        info "  Installing bat Catppuccin Mocha theme..."
        mkdir -p "$BAT_THEMES_DIR"
        if curl -fsSLo "$BAT_THEMES_DIR/Catppuccin Mocha.tmTheme" \
            "https://raw.githubusercontent.com/catppuccin/bat/main/themes/Catppuccin%20Mocha.tmTheme"; then
            bat cache --build
            info "  bat Catppuccin Mocha theme installed successfully"
        else
            error "Failed to download bat Catppuccin Mocha theme"
        fi
    fi
fi

# ------------------------------------------------------------------
# Delta theme: Catppuccin Mocha
# ------------------------------------------------------------------
DELTA_THEME_PATH="$HOME/.config/delta/catppuccin.gitconfig"
if [ -f "$DELTA_THEME_PATH" ]; then
    info "  delta Catppuccin Mocha theme — already installed, skipping"
else
    info "  Installing delta Catppuccin Mocha theme..."
    mkdir -p "$(dirname "$DELTA_THEME_PATH")"
    if curl -fsSLo "$DELTA_THEME_PATH" \
        "https://raw.githubusercontent.com/catppuccin/delta/main/catppuccin.gitconfig"; then
        info "  delta Catppuccin Mocha theme installed successfully"
    else
        error "Failed to download delta Catppuccin Mocha theme"
    fi
fi

# ------------------------------------------------------------------
# zsh-syntax-highlighting theme: Catppuccin Mocha
# ------------------------------------------------------------------
ZSH_SYNTAX_THEME_PATH="$HOME/.zsh/catppuccin_mocha-zsh-syntax-highlighting.zsh"
if [ -f "$ZSH_SYNTAX_THEME_PATH" ]; then
    info "  zsh-syntax-highlighting Catppuccin Mocha theme — already installed, skipping"
else
    info "  Installing zsh-syntax-highlighting Catppuccin Mocha theme..."
    mkdir -p "$(dirname "$ZSH_SYNTAX_THEME_PATH")"
    if curl -fsSLo "$ZSH_SYNTAX_THEME_PATH" \
        "https://raw.githubusercontent.com/catppuccin/zsh-syntax-highlighting/main/themes/catppuccin_mocha-zsh-syntax-highlighting.zsh"; then
        info "  zsh-syntax-highlighting Catppuccin Mocha theme installed successfully"
    else
        error "Failed to download zsh-syntax-highlighting Catppuccin Mocha theme"
    fi
fi

# ------------------------------------------------------------------
# Atuin theme: Catppuccin Mocha Blue
# ------------------------------------------------------------------
ATUIN_THEME_PATH="$HOME/.config/atuin/themes/catppuccin-mocha-blue.toml"
if [ -f "$ATUIN_THEME_PATH" ]; then
    info "  atuin Catppuccin Mocha Blue theme — already installed, skipping"
else
    info "  Installing atuin Catppuccin Mocha Blue theme..."
    mkdir -p "$(dirname "$ATUIN_THEME_PATH")"
    if curl -fsSLo "$ATUIN_THEME_PATH" \
        "https://raw.githubusercontent.com/catppuccin/atuin/main/themes/mocha/catppuccin-mocha-blue.toml"; then
        info "  atuin Catppuccin Mocha Blue theme installed successfully"
    else
        error "Failed to download atuin Catppuccin Mocha Blue theme"
    fi
fi

# ------------------------------------------------------------------
# tmux plugin: Catppuccin (pinned to v2.3.0)
# ------------------------------------------------------------------
TMUX_CATPPUCCIN_DIR="$HOME/.config/tmux/plugins/catppuccin/tmux"
if [ -d "$TMUX_CATPPUCCIN_DIR" ]; then
    info "  tmux Catppuccin plugin — already installed, skipping"
else
    info "  Installing tmux Catppuccin plugin (v2.3.0)..."
    mkdir -p "$(dirname "$TMUX_CATPPUCCIN_DIR")"
    if git clone --depth 1 --branch v2.3.0 \
        "https://github.com/catppuccin/tmux.git" "$TMUX_CATPPUCCIN_DIR"; then
        info "  tmux Catppuccin plugin installed successfully"
    else
        error "Failed to clone tmux Catppuccin plugin"
    fi
fi

# ------------------------------------------------------------------
# Group: gh CLI extensions
# ------------------------------------------------------------------
if command -v gh &>/dev/null; then
    if confirm "Install gh CLI extensions (gh-dash, gh-enhance, gh-stack) + gh agent skills?"; then
        # Match the whole OWNER/REPO token in gh extension list's tab-separated
        # output; a substring match would treat e.g. gh-dash-extra as gh-dash.
        if gh extension list 2>/dev/null | grep -qE '(^|[[:space:]])dlvhdr/gh-dash([[:space:]]|$)'; then
            info "  gh-dash — already installed, skipping"
        else
            info "  Installing gh-dash..."
            if ! gh extension install dlvhdr/gh-dash; then
                error "Failed to install gh-dash"
            fi
        fi

        if gh extension list 2>/dev/null | grep -qE '(^|[[:space:]])dlvhdr/gh-enhance([[:space:]]|$)'; then
            info "  gh-enhance — already installed, skipping"
        else
            info "  Installing gh-enhance..."
            if ! gh extension install dlvhdr/gh-enhance; then
                error "Failed to install gh-enhance"
            fi
        fi

        if gh extension list 2>/dev/null | grep -qE '(^|[[:space:]])github/gh-stack([[:space:]]|$)'; then
            info "  gh-stack — already installed, skipping"
        else
            info "  Installing gh-stack..."
            if ! gh extension install github/gh-stack; then
                error "Failed to install gh-stack"
            fi
        fi

        # Official gh agent skills. `gh skill` landed in 2.90, but the guard
        # below needs `gh skill list` (2.94+), so 2.94 is the real floor here.
        # Structured detection via --json instead of grepping human-readable
        # output. --scope user is required: gh skill list defaults to project +
        # user, so a project-scoped skill would mask a missing user-scoped one.
        #
        # Do NOT add `--agent claude-code` to the *list* filter, even though the
        # install side needs it to pick the destination. gh puts the skill body
        # in ~/.agents/skills/<name> and leaves ~/.claude/skills/<name> as a
        # symlink to it. `gh skill list` reports the resolved path, so these come
        # back under the agent hosts `cline, universal, warp`, never
        # `claude-code`. So an --agent-filtered check never matched, the script
        # reinstalled on every run, and `gh skill install` stopped at its
        # "already exists, overwrite?" prompt — which then died on the
        # terminal's OSC 11 reply ("could not prompt: unexpected escape
        # sequence from terminal"). That error made the script exit non-zero,
        # so chezmoi never recorded the run_onchange state and `chezmoi diff`
        # never came back clean.
        #
        # `--force` is the second line of defence: if the check ever misses
        # again, the install overwrites silently instead of blocking on a prompt
        # that cannot be answered through chezmoi's stdio.
        gh_skill_installed() {
            gh skill list --scope user --json skillName --jq '.[].skillName' 2>/dev/null | grep -qx "$1"
        }

        if gh_skill_installed "gh"; then
            info "  gh agent skill — already installed, skipping"
        else
            info "  Installing gh agent skill (Claude Code, user scope)..."
            if ! gh skill install cli/cli gh --agent claude-code --scope user --force; then
                error "Failed to install gh agent skill"
            fi
        fi

        if gh_skill_installed "gh-stack"; then
            info "  gh-stack agent skill — already installed, skipping"
        else
            info "  Installing gh-stack agent skill (Claude Code, user scope)..."
            if ! gh skill install github/gh-stack gh-stack --agent claude-code --scope user --force; then
                error "Failed to install gh-stack agent skill"
            fi
        fi
    else
        info "Skipping gh CLI extensions."
    fi
else
    warn "gh CLI is not installed — skipping gh extensions"
fi

# ------------------------------------------------------------------
# Group 2: Fonts
# ------------------------------------------------------------------
# Only a Homebrew cask counts as installed. A hand-copied .ttf under
# ~/Library/Fonts is frozen at whatever version was copied: outside brew's view,
# never listed by `brew outdated`, never advanced by `brew upgrade`. The primary
# font draws every eza icon and every nerdFontsVersion:"3" glyph, so treating a
# manual copy as satisfied silently caps glyph coverage. It also blocks the cask,
# which refuses to overwrite a real file at its target path — so the fix is
# always "delete the copies, then install", never "install over them".
FONT_CASKS=("font-hack-nerd-font:HackNerdFont" "font-jetbrains-mono-nerd-font:JetBrainsMonoNerdFont")

font_manual_installed() {
    local f
    for f in "$HOME"/Library/Fonts/"$1"*.ttf; do
        [ -e "$f" ] && return 0
    done
    return 1
}

# Pre-scan
FONTS_PENDING=0
FONTS_MANUAL=0
for font_spec in "${FONT_CASKS[@]}"; do
    brew list --cask "${font_spec%%:*}" &>/dev/null && continue
    FONTS_PENDING=$((FONTS_PENDING + 1))
    if font_manual_installed "${font_spec##*:}"; then
        FONTS_MANUAL=$((FONTS_MANUAL + 1))
    fi
done

if [ "$FONTS_PENDING" -eq 0 ]; then
    info "Fonts: ${#FONT_CASKS[@]}/${#FONT_CASKS[@]} installed (Homebrew casks)"
else
    if [ "$FONTS_MANUAL" -gt 0 ]; then
        warn "$FONTS_MANUAL font(s) present as manual copies in ~/Library/Fonts, not under Homebrew."
        warn "  A manual copy is never upgraded and never reported as outdated."
        for font_spec in "${FONT_CASKS[@]}"; do
            if ! brew list --cask "${font_spec%%:*}" &>/dev/null && font_manual_installed "${font_spec##*:}"; then
                warn "  ${font_spec%%:*}: rm ~/Library/Fonts/${font_spec##*:}*.ttf, then re-run this script"
            fi
        done
    fi
    if confirm "Install terminal fonts ($FONTS_PENDING/${#FONT_CASKS[@]} pending)?"; then
        info "Installing terminal fonts..."
        for font_spec in "${FONT_CASKS[@]}"; do
            font_cask="${font_spec%%:*}"
            font_prefix="${font_spec##*:}"
            if brew list --cask "$font_cask" &>/dev/null; then
                info "  $font_cask — already installed (via brew), skipping"
            elif font_manual_installed "$font_prefix"; then
                warn "  $font_cask — skipped: manual copies at ~/Library/Fonts/$font_prefix*.ttf would block the cask install"
            elif ! brew install --cask "$font_cask"; then
                error "Failed to install $font_cask"
            fi
        done
    else
        info "Skipping font installation."
    fi
fi

# ------------------------------------------------------------------
# Group 3: Oh-my-zsh + plugins
# ------------------------------------------------------------------
# Pre-scan: check if oh-my-zsh and plugins are already installed
OMZ_PENDING=0
[ -d "$HOME/.oh-my-zsh" ] || OMZ_PENDING=$((OMZ_PENDING + 1))
YSU_DIR="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/you-should-use"
[ -d "$YSU_DIR" ] || OMZ_PENDING=$((OMZ_PENDING + 1))
for pkg in zsh-autosuggestions zsh-syntax-highlighting zsh-completions; do
    brew list "$pkg" &>/dev/null || OMZ_PENDING=$((OMZ_PENDING + 1))
done

if [ "$OMZ_PENDING" -eq 0 ]; then
    info "Oh-my-zsh + plugins: 5/5 installed"
elif confirm "Install oh-my-zsh and zsh plugins ($OMZ_PENDING/5 pending)?"; then
    # oh-my-zsh
    if [ -d "$HOME/.oh-my-zsh" ]; then
        info "  oh-my-zsh — already installed, skipping"
    else
        info "  Installing oh-my-zsh..."
        if ! sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended; then
            error "Failed to install oh-my-zsh"
        fi
    fi

    # you-should-use plugin (git clone)
    if [ -d "$YSU_DIR" ]; then
        info "  you-should-use plugin — already installed, skipping"
    else
        info "  Cloning you-should-use plugin..."
        if ! git clone https://github.com/MichaelAquilina/zsh-you-should-use.git "$YSU_DIR"; then
            error "Failed to clone you-should-use plugin"
        fi
    fi

    # zsh-autosuggestions and zsh-syntax-highlighting via brew
    for pkg in zsh-autosuggestions zsh-syntax-highlighting zsh-completions; do
        if brew list "$pkg" &>/dev/null; then
            info "  $pkg — already installed, skipping"
        else
            info "  Installing $pkg..."
            if ! brew install "$pkg"; then
                error "Failed to install $pkg"
            fi
        fi
    done
else
    info "Skipping oh-my-zsh and zsh plugins."
fi

