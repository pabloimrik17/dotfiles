#!/bin/bash

# Re-runnable account enrollment for the repo-pinned claude-swap integration.
# Credentials remain owned by Claude Code / claude-swap; this command reads only
# public schema-v1 JSON. It never removes an account, and disables one only to
# restore a hold-out that a recapture would clear.

MACHINE_TYPE={{ get . "machineType" | default "" | quote }}
CLAUDE_SWAP_VERSION="0.29.0"
# alias:priority-tier:switch-line. Keep it on one line:
# run_onchange_after_claude-swap-setup.sh.tmpl extracts it by regex.
ROTATION_POLICY="personal2:100:95 work:50:60 personal:10:80"
USAGE="Usage: claude-swap-setup [--check | --apply-policy | --enroll personal2 | --reauth personal|work|personal2]"

info() {
    printf '[claude-swap-setup] %s\n' "$*"
}

error() {
    printf '[claude-swap-setup] ERROR: %s\n' "$*" >&2
}

recovery_instruction() {
    printf "Run 'chezmoi init', choose personal or work, then run 'chezmoi apply' again."
}

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        error "Missing prerequisite: $1"
        return 1
    fi
}

cswap_version() {
    local output
    output="$(cswap --version 2>/dev/null)" || return 1
    printf '%s\n' "${output##* }"
}

preflight() {
    case "$MACHINE_TYPE" in
        personal|work) ;;
        "")
            error "Machine type is not configured. $(recovery_instruction)"
            return 1
            ;;
        *)
            error "Invalid machine type '$MACHINE_TYPE'. $(recovery_instruction)"
            return 1
            ;;
    esac

    if [ "$(uname -s)" != "Darwin" ]; then
        error "claude-swap setup is supported only on macOS"
        return 1
    fi

    require_command jq || return 1
    require_command claude || return 1
    require_command cswap || return 1

    local installed_version
    installed_version="$(cswap_version 2>/dev/null || true)"
    if [ "$installed_version" != "$CLAUDE_SWAP_VERSION" ]; then
        error "Expected cswap $CLAUDE_SWAP_VERSION, found ${installed_version:-missing}. Run 'chezmoi apply' to restore the repository pin."
        return 1
    fi
}

load_public_state() {
    if ! LIST_JSON="$(cswap list --json)"; then
        error "Could not inspect managed accounts with 'cswap list --json'"
        return 1
    fi
    if ! printf '%s\n' "$LIST_JSON" | jq -e '
        .schemaVersion == 1 and
        (.accounts | type == "array") and
        ([.accounts[] | (.number | type == "number")] | all)
    ' >/dev/null 2>&1; then
        error "Malformed or unsupported JSON from 'cswap list --json'"
        return 1
    fi

    load_status
}

load_status() {
    if ! STATUS_JSON="$(cswap status --json)"; then
        error "Could not inspect the active account with 'cswap status --json'"
        return 1
    fi
    if ! printf '%s\n' "$STATUS_JSON" | jq -e '
        .schemaVersion == 1 and
        (has("active")) and
        (.active == null or (.active | type == "object"))
    ' >/dev/null 2>&1; then
        error "Malformed or unsupported JSON from 'cswap status --json'"
        return 1
    fi
}

alias_count() {
    printf '%s\n' "$LIST_JSON" | jq -r --arg alias "$1" '[.accounts[] | select((.alias // "") == $alias)] | length'
}

account_number_for_alias() {
    printf '%s\n' "$LIST_JSON" | jq -r --arg alias "$1" '[.accounts[] | select((.alias // "") == $alias)][0].number // empty'
}

account_count() {
    printf '%s\n' "$LIST_JSON" | jq -r '.accounts | length'
}

active_alias() {
    printf '%s\n' "$STATUS_JSON" | jq -r '.active.alias // ""'
}

active_number() {
    printf '%s\n' "$STATUS_JSON" | jq -r '.active.number // empty'
}

reject_unexpected_work_accounts() {
    [ "$MACHINE_TYPE" = "work" ] || return 0

    local unexpected
    unexpected="$(printf '%s\n' "$LIST_JSON" | jq -r '[.accounts[] | select((.alias // "") != "work")] | length')"
    if [ "$unexpected" -eq 0 ]; then
        return 0
    fi

    error "Work-machine policy found managed accounts other than the native 'work' alias:"
    printf '%s\n' "$LIST_JSON" | jq -r '
        .accounts[] |
        select((.alias // "") != "work") |
        "  - account \(.number): \(.email // "<unknown>") (alias: \(.alias // "<none>"))"
    '
    error "Review each identity with 'cswap list', then remove it explicitly with 'cswap remove <number-or-alias>' if appropriate. Nothing was removed or disabled."
    return 1
}

setup_is_complete() {
    if [ "$MACHINE_TYPE" = "personal" ]; then
        [ "$(alias_count personal)" -eq 1 ] &&
            [ "$(alias_count work)" -eq 1 ]
        return
    fi

    [ "$(account_count)" -eq 1 ] &&
        [ "$(alias_count work)" -eq 1 ] &&
        [ "$(active_alias)" = "work" ]
}

describe_incomplete_setup() {
    if [ "$MACHINE_TYPE" = "personal" ]; then
        info "Incomplete personal setup: required aliases are 'personal' and 'work'."
    else
        info "Incomplete work setup: the only managed alias must be 'work', and it must be active."
    fi
}

enroll_alias() {
    local alias="$1"
    if [ "$(alias_count "$alias")" -eq 1 ]; then
        info "Account alias '$alias' is already enrolled; leaving it unchanged."
        return 0
    fi

    info "Enroll the '$alias' Claude subscription now."
    info "Do NOT run /logout: it can revoke the refresh token that claude-swap must preserve."
    info "In Claude Code, use /login to authenticate '$alias', then return here."
    printf "[claude-swap-setup] Press Enter after '$alias' is the current Claude login... "
    if ! read -r _reply; then
        printf '\n' >&2
        error "Enrollment requires an interactive terminal; re-run claude-swap-setup later."
        return 1
    fi
    load_status || return 1
    local current_alias
    current_alias="$(active_alias)"
    if [ -n "$current_alias" ] && [ "$current_alias" != "$alias" ]; then
        error "The current Claude login is already enrolled as '$current_alias'; capturing it would rename that account. Use /login to authenticate '$alias', then re-run this command. Nothing was changed."
        return 1
    fi
    if ! cswap add --alias "$alias"; then
        error "Could not capture the current Claude login as '$alias'"
        return 1
    fi
    load_public_state || return 1
    if [ "$(alias_count "$alias")" -ne 1 ]; then
        error "cswap did not report exactly one '$alias' account after capture"
        return 1
    fi
    CAPTURED=1
    info "Captured '$alias'."
}

reauthenticate_alias() {
    local alias="$1"
    if [ "$(alias_count "$alias")" -ne 1 ]; then
        error "Cannot reauthenticate '$alias': expected exactly one enrolled account with that alias."
        return 1
    fi

    local slot held_out
    slot="$(account_number_for_alias "$alias")"
    held_out="$(printf '%s\n' "$LIST_JSON" | jq -r --arg alias "$alias" '[.accounts[] | select((.alias // "") == $alias)][0].disabled // false')"
    info "Reauthenticate the '$alias' Claude subscription now."
    info "Do NOT run /logout: it can revoke the refresh token that claude-swap must preserve."
    info "In Claude Code, use /login to authenticate '$alias', then return here."
    printf "[claude-swap-setup] Press Enter after '$alias' is the current Claude login... "
    if ! read -r _reply; then
        printf '\n' >&2
        error "Reauthentication requires an interactive terminal; re-run claude-swap-setup later."
        return 1
    fi
    load_status || return 1
    local current_slot
    current_slot="$(active_number)"
    if [ -n "$current_slot" ] && [ "$current_slot" != "$slot" ]; then
        error "The current Claude login is account $current_slot, not '$alias'; capturing it would move that account into slot $slot. Use /login to authenticate '$alias', then re-run this command. Nothing was changed."
        return 1
    fi
    if ! cswap add --slot "$slot"; then
        error "Could not recapture '$alias' in slot $slot"
        return 1
    fi
    load_public_state || return 1
    if [ "$(alias_count "$alias")" -ne 1 ] || [ "$(account_number_for_alias "$alias")" != "$slot" ]; then
        error "cswap did not preserve '$alias' in slot $slot after recapture"
        return 1
    fi
    # `add --slot` rebuilds the record: tier and line come back through
    # apply_rotation_policy, `disabled` only here.
    if [ "$held_out" = "true" ] && ! cswap disable "$alias" >/dev/null; then
        error "Could not restore the hold-out on '$alias' after recapture"
        return 1
    fi
    info "Recaptured '$alias' in slot $slot."
}

select_final_account() {
    local required="$1"
    if ! cswap switch "$required"; then
        error "Could not switch the global Claude Code identity to '$required'"
        return 1
    fi
    load_public_state || return 1
    if [ "$(active_alias)" != "$required" ]; then
        error "Expected '$required' to be globally active after the switch"
        return 1
    fi
    info "Global Claude Code identity is '$required'."
}

restore_active_account() {
    local previous="$1"
    if [ -z "$previous" ]; then
        info "No managed account was active before the capture; the captured login stays active."
        return 0
    fi
    if [ "$(active_number)" = "$previous" ]; then
        return 0
    fi
    if ! cswap switch "$previous"; then
        error "Could not switch back to account $previous, which was active before the capture"
        return 1
    fi
    load_public_state || return 1
    if [ "$(active_number)" != "$previous" ]; then
        error "Expected account $previous to be globally active again after the capture"
        return 1
    fi
    info "Restored the previously active account '$(active_alias)'."
}

apply_rotation_policy() {
    [ "$MACHINE_TYPE" = "personal" ] || return 0

    local entry alias tier line
    for entry in $ROTATION_POLICY; do
        IFS=: read -r alias tier line <<<"$entry"
        [ "$(alias_count "$alias")" -eq 1 ] || continue
        if ! cswap priority "$alias" "$tier" >/dev/null ||
            ! cswap threshold "$alias" "$line" >/dev/null; then
            error "Could not apply the rotation tier and switch line to '$alias'"
            return 1
        fi
    done
    info "Rotation tiers and switch lines applied to the enrolled accounts."
}

run_personal_dry_run() {
    [ "$MACHINE_TYPE" = "personal" ] || return 0

    info "Running a side-effect-free autoswitch evaluation..."
    cswap auto --once --dry-run
    local dry_run_status=$?
    case "$dry_run_status" in
        0|2|3)
            info "Autoswitch dry-run completed without changing the active account."
            ;;
        *)
            error "Autoswitch dry-run failed (exit $dry_run_status)"
            return 1
            ;;
    esac
}

install_menu_service() {
    info "Installing or refreshing the upstream claude-swap menu service..."
    if ! cswap menubar --install-service; then
        error "Could not install the upstream menu service"
        return 1
    fi

    local service_status
    if ! service_status="$(cswap menubar --service-status)"; then
        error "Could not query the upstream menu service"
        return 1
    fi
    case "$service_status" in
        "Menu bar service:"*) ;;
        *)
            error "Menu service verification did not report an installed service"
            printf '%s\n' "$service_status" >&2
            return 1
            ;;
    esac
    printf '%s\n' "$service_status"
}

validate_target() {
    local mode="$1" alias="$2"
    case "$mode:$alias" in
        reauth:work) return 0 ;;
        reauth:personal|reauth:personal2|enroll:personal2) ;;
        *)
            error "$USAGE"
            return 1
            ;;
    esac
    if [ "$MACHINE_TYPE" != "personal" ]; then
        if [ "$mode" = "enroll" ]; then
            error "Cannot enroll '$alias' on a work machine."
        else
            error "Cannot reauthenticate '$alias' on a work machine."
        fi
        return 1
    fi
}

main() {
    local mode="setup"
    local target_alias=""
    local setup_complete=0
    local enrolled_required=0
    local previous_active=""
    case "${1:-}" in
        --check|--apply-policy)
            [ "$#" -eq 1 ] || {
                error "$USAGE"
                return 2
            }
            mode="${1#--}"
            ;;
        --reauth|--enroll)
            [ "$#" -eq 2 ] || {
                error "$USAGE"
                return 2
            }
            mode="${1#--}"
            target_alias="$2"
            ;;
        "") ;;
        *)
            error "$USAGE"
            return 2
            ;;
    esac

    preflight || return 1
    if [ -n "$target_alias" ]; then
        validate_target "$mode" "$target_alias" || return 2
    fi
    load_public_state || return 1

    if [ "$mode" = "apply-policy" ]; then
        apply_rotation_policy
        return
    fi

    reject_unexpected_work_accounts || return 1
    previous_active="$(active_number)"

    if setup_is_complete; then
        info "Setup is complete for this $MACHINE_TYPE machine."
        setup_complete=1
        if [ "$mode" = "check" ]; then
            return 0
        fi
    else
        describe_incomplete_setup
        if [ "$mode" = "check" ]; then
            return 2
        fi
    fi

    case "$mode" in
        reauth) reauthenticate_alias "$target_alias" || return 1 ;;
        enroll) enroll_alias "$target_alias" || return 1 ;;
    esac

    if [ "$setup_complete" -eq 0 ]; then
        CAPTURED=0
        if [ "$MACHINE_TYPE" = "personal" ]; then
            enroll_alias personal || return 1
            enroll_alias work || return 1
        else
            enroll_alias work || return 1
            reject_unexpected_work_accounts || return 1
        fi
        enrolled_required="$CAPTURED"
    fi

    if [ "$enrolled_required" -eq 1 ] && [ "$MACHINE_TYPE" = "personal" ]; then
        select_final_account personal || return 1
    elif [ "$MACHINE_TYPE" = "work" ] && [ "$setup_complete" -eq 0 ]; then
        select_final_account work || return 1
    elif [ "$mode" = "reauth" ] || [ "$mode" = "enroll" ]; then
        restore_active_account "$previous_active" || return 1
    fi

    apply_rotation_policy || return 1
    run_personal_dry_run || return 1
    install_menu_service || return 1

    if [ "$MACHINE_TYPE" = "personal" ]; then
        info "Enable Settings → Auto-switch accounts in the claude-swap menu."
    else
        info "Leave Settings → Auto-switch accounts disabled on this work machine."
    fi
    info "Setup complete. Re-run this command later for repair or reauthentication."
}

main "$@"
